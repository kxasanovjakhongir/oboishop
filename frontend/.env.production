# These are PUBLIC values baked into the client bundle at build time (Vite
# only exposes VITE_-prefixed vars, and does so by inlining them into the
# JS — never put secrets here). Replace with your real domain before deploy.
VITE_API_URL=https://api.oboishop.uz/api
VITE_SITE_URL=https://oboishop.uz
