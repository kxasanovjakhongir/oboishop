# Copy this file to .env (local dev) or .env.production (server) and fill in real values.
# Never commit the filled-in file — .env* is gitignored except this example.

NODE_ENV=development
PORT=8003

# MongoDB connection string. Local dev: mongodb://localhost:27017/wallpaper_studio
# Production: use a Mongo Atlas / managed URI with auth, e.g.
# mongodb+srv://user:pass@cluster.mongodb.net/wallpaper_studio
MONGODB_URI=mongodb://localhost:27017/wallpaper_studio

# Long, random secret used to sign admin JWTs. Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Seeded on first boot if no admin exists yet. Change the password in
# production before going live, then it's safe to leave these set (they're
# only used for the initial seed, not read on every login).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Comma-separated list of exact origins allowed to call this API.
# Dev default: http://localhost:3000,http://localhost:3001
# Production example: https://oboishop.uz,https://admin.oboishop.uz
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Telegram bot that receives order notifications. Create a bot via
# @BotFather, add it to your order-notifications group/channel, and get the
# chat id (e.g. by messaging the bot and checking
# https://api.telegram.org/bot<token>/getUpdates).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
